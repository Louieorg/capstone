APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capstone
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# DB_QUEUE_RETRY_AFTER must stay greater than the longest job timeout.
# DB_QUEUE_RETRY_AFTER=360
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=20
OLLAMA_CONNECT_TIMEOUT=5
# Enable only after enhance input, throttling, output, and failure handling are hardened.
OLLAMA_ENHANCE_ENABLED=false

# Cluster explanation ("What People Are Experiencing"). Uncomment to override.
# Each value falls back to the matching shared OLLAMA_* setting above, so the
# feature behaves identically until one is set explicitly.
# OLLAMA_SYNTHESIS_MODEL=llama3.2
# OLLAMA_SYNTHESIS_TIMEOUT=20
# OLLAMA_SYNTHESIS_CONNECT_TIMEOUT=5
# Tokens the model may generate. -1 is Ollama's own unlimited default; the
# validator rejects over-long output, so a cap is a cost choice, not a guard.
# OLLAMA_SYNTHESIS_NUM_PREDICT=-1
# How long Ollama keeps the model resident, e.g. 30m. Blank omits the field
# and lets Ollama use its own default. Set it on every profile that shares a
# model, otherwise alternating models reload on every switch.
# OLLAMA_SYNTHESIS_KEEP_ALIVE=30m
# Named queue drained by the worker, e.g.
#   php artisan queue:work database --queue=ai-synthesis,ai-filipino,ai-cluster --sleep=1 --tries=1 --timeout=300
# Run exactly one worker so these jobs never overlap.
# OLLAMA_SYNTHESIS_QUEUE=ai-synthesis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
